{
	"schemaVersion": 1,
	"id": "nbt-viewer",
	"version": "${version}",
	"name": "NBT Viewer",
	"description": "查看物品或實體的NBT小工具",
	"authors": [
		"Ice//2026"
	],
	"contact": {
		"sources": "https://github.com/IceBearowob/nbt-viewer"
	},
	"license": "unlicense",
	"icon": "assets/nbt-viewer/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"ice.nbtviewer.NbtViewer"
		],
		"client": ["ice.nbtviewer.client.NbtViewerClient"],
		"modmenu": ["ice.nbtviewer.client.ModMenuIntegration"]
	},
	"mixins": [
		{"config": "nbt-viewer.client.mixins.json", "environment": "client"}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
